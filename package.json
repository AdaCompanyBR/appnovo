{
  "name": "demandas",
  "productName": "Lumo",
  "version": "1.0.0",
  "description": "Lumo: anote suas demandas do dia a dia em segundos.",
  "main": "src/main/main.js",
  "author": "Guilherme Evaristo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "br.com.adacompany.demandas",
    "productName": "Lumo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lumo",
      "artifactName": "Lumo-instalador-${version}.exe"
    },
    "publish": null,
    "portable": {
      "artifactName": "Lumo-portatil-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "lucide-static": "^1.70.0",
    "quill": "^2.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdaCompanyBR/appnovo.git"
  }
}
